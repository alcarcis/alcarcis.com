---
import RerunIcon from "../assets/icons/rerun.svg";
import { useTranslations, type Locale } from "../i18n/ui";
import { minimumCategoryScore } from "../../scripts/quality-budget";
import { buildInfo } from "../lib/build-info";
import { instrumentRows } from "../lib/instrument-rows";
import { finalFrame } from "../scripts/glyphs/final-frame";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* Terminal vocabulary stays English on every page, as a real test log would; this marks it
   for assistive technology and translation on pages in other languages. */
const terminalLang = locale === "en" ? undefined : "en";

const stageNames = ["requirements", "design", "code", "ci/cd", "production"];
const lastStage = stageNames.length - 1;

type TokenKind = "fn" | "str" | "kw" | "id" | "punct";
const spec: readonly (readonly [TokenKind, string])[] = [
  ["fn", "test"],
  ["punct", "("],
  ["str", "'quality, end to end'"],
  ["punct", ", "],
  ["kw", "async"],
  ["punct", " () => {\n  "],
  ["kw", "for"],
  ["punct", " ("],
  ["kw", "const"],
  ["punct", " "],
  ["id", "stage"],
  ["punct", " "],
  ["kw", "of"],
  ["punct", " "],
  ["id", "development"],
  ["punct", ")\n    "],
  ["kw", "await"],
  ["punct", " "],
  ["fn", "expect"],
  ["punct", "("],
  ["id", "stage"],
  ["punct", ")."],
  ["fn", "toHaveQuality"],
  ["punct", "();\n});"],
];
const specText = spec
  .map(([, text]) => text)
  .join("")
  .replace(/\s+/g, " ");

/* One row per fact the build could read; the budget states what lighthouserc.cjs enforces. */
const dataRows = instrumentRows(buildInfo(), minimumCategoryScore);

/* What the run script writes as the scene plays, in this page's language. */
const runCopy = {
  captions: [
    t("instrument.caption.requirements"),
    t("instrument.caption.design"),
    t("instrument.caption.code"),
    t("instrument.caption.cicd"),
    t("instrument.caption.production"),
  ],
  fixCaption: t("instrument.caption.fix"),
  states: {
    passed: t("instrument.state.passed"),
    running: t("instrument.state.running"),
    pending: t("instrument.state.pending"),
  },
  passed: t("instrument.announce.passed"),
};
---

<aside
  class="instrument"
  aria-label={t("instrument.label")}
  data-instrument
  data-run-state="final"
  data-run-copy={JSON.stringify(runCopy)}
>
  <svg class="marker" viewBox="0 0 20 20" aria-hidden="true">
    <circle class="marker-ground" cx="10" cy="10" r="9.5"></circle>
    <path
      class="marker-quarters"
      d="M10 10V1.5A8.5 8.5 0 0 1 18.5 10ZM10 10v8.5A8.5 8.5 0 0 1 1.5 10Z"
    ></path>
    <circle class="marker-ring" cx="10" cy="10" r="8.5"></circle>
  </svg>

  <div class="bar">
    <span class="title" lang={terminalLang}>
      <span class="suite">Suite</span> · quality.spec.ts
    </span>
    <button
      class="control"
      type="button"
      aria-label={t("instrument.skip")}
      data-skip
      hidden
    >
      <span aria-hidden="true">[</span>Skip<span aria-hidden="true">]</span>
    </button>
    <span class="status" lang={terminalLang} data-run-status>
      Passed
    </span>
    <button
      class="control"
      type="button"
      aria-label={t("instrument.rerun")}
      data-rerun
    >
      <span aria-hidden="true">[</span>
      <RerunIcon width={13} height={13} aria-hidden="true" />
      Rerun<span aria-hidden="true">]</span>
    </button>
    <span class="visually-hidden" role="status" data-run-live></span>
  </div>

  <div class="scene" aria-hidden="true" data-scene>
    {/* Zero-size until the renderer sizes it, so drawing in never counts as a layout shift. */}
    <canvas width="0" height="0" data-scene-canvas></canvas>
    <span class="scene-label" data-scene-label>
      {t("instrument.sceneLabel")}
    </span>
    {/* Spaces are explicit: the HTML compressor drops whitespace at line breaks. */}
    {/* The renderer's last frame in text, so it shows before (and without) the renderer. */}
    <p class="scene-still" data-scene-still>
      {finalFrame.map((line) => (
        <span>
          {line.map(([ink, text]) => (
            <span class={`frame-${ink}`}>{text}</span>
          ))}
        </span>
      ))}
    </p>
    <span class="scene-caption" data-scene-caption>
      <span>
        <span class="caption-number">0{lastStage + 1}</span>{" "}
        <span class="caption-stage">{stageNames[lastStage]}</span>
        {" · "}
        <span class="caption-action">{t("instrument.caption.production")}</span>
      </span>
    </span>
  </div>

  <div class="body">
    <pre
      class="spec"
      aria-hidden="true"
    ><code data-spec>{spec.map(([kind, text]) => kind === "punct" ? text : <span class={kind}>{text}</span>)}</code></pre>
    <p class="visually-hidden" lang="en">
      {specText}
    </p>

    <ol class="stages" aria-label={t("instrument.stages")}>
      {stageNames.map((name) => (
        <li class="stage" data-stage>
          <span class="stage-name" lang={terminalLang}>
            {name}
          </span>
          <span class="leader" aria-hidden="true" />
          <span class="stage-run" aria-hidden="true">
            running…
          </span>
          <svg
            class="check"
            viewBox="0 0 18 18"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="square"
            aria-hidden="true"
          >
            <rect class="check-box" x="4.5" y="4.5" width="9" height="9" />
            <path d="M4 9.5l3.2 3L14 5.5" />
          </svg>{" "}
          <span class="visually-hidden" data-stage-state>
            {t("instrument.state.passed")}
          </span>
        </li>
      ))}
    </ol>

    <dl class="data" lang={terminalLang} data-rows>
      {dataRows.map(({ term, value, datetime }) => (
        <div>
          <dt>{term}</dt>
          <dd>{datetime ? <time datetime={datetime}>{value}</time> : value}</dd>
        </div>
      ))}
    </dl>
  </div>
</aside>

<script>
  import "../scripts/instrument/run";
</script>

<style>
  .instrument {
    position: relative;
    border: 1px solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--type-ui-size);
    line-height: calc(22 / 13);
    cursor: default;
  }

  /* A calibration mark on the card's corner. */
  .marker {
    position: absolute;
    inset-block-start: -10px;
    inset-inline-end: -10px;
    z-index: 1;
    inline-size: 20px;
    block-size: 20px;
  }

  .marker-ground {
    fill: var(--ground);
  }

  .marker-quarters {
    fill: var(--fill);
  }

  .marker-ring {
    fill: none;
    stroke: var(--text);
    stroke-width: 1;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    block-size: var(--space-10);
    padding-inline: var(--space-4) var(--space-2);
    border-block-end: 1px solid var(--rule);
    background: var(--panel);
    color: var(--text);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .title {
    margin-inline-end: auto;
  }

  .suite {
    color: var(--link);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--muted);

    &::before {
      content: "";
      inline-size: 6px;
      block-size: 6px;
      background: var(--pass);
    }
  }

  /* While a run plays the status reads in soft copper (the darker copper on paper). */
  .instrument:not([data-run-state="final"]) .status {
    color: var(--accent-text);

    &::before {
      background: var(--link);
    }
  }

  .control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    block-size: var(--space-7);
    padding: 0 var(--space-2);
    border: 1px solid transparent;
    background: transparent;
    color: var(--muted);
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out),
      opacity var(--duration-quick) var(--ease-out);

    &[hidden] {
      display: none;
    }

    &:hover {
      border-color: var(--dots);
      color: var(--text);
    }

    /* Disabled while a run plays; aria-disabled keeps focus on the button instead of dropping it. */
    &[aria-disabled="true"] {
      opacity: 0.45;
      cursor: default;

      &:hover {
        border-color: transparent;
        color: var(--muted);
      }
    }
  }

  /* Without scripting there is no run to replay. */
  @media (scripting: none) {
    [data-rerun] {
      display: none;
    }
  }

  /* The scene: what QA does at each stage, in glyphs. Its size is fixed, so nothing it draws
     can move the page. */
  .scene {
    position: relative;
    block-size: 16rem;
    overflow: hidden;
    border-block-end: 1px solid var(--rule);
    background: var(--ground);
  }

  .scene-label,
  .scene-caption {
    position: absolute;
    z-index: 1;
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1rem;
  }

  .scene-label {
    inset-block-start: var(--space-3);
    inset-inline-start: var(--space-4);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The caption names the stage the scene is playing, the same as the running row. Its box
     spans the scene at a fixed height. */
  .scene-caption {
    display: flex;
    align-items: flex-end;
    inset-block-end: 10px;
    inset-inline: var(--space-4);
    block-size: var(--space-4);
    overflow: hidden;
    white-space: nowrap;
  }

  .scene canvas {
    position: absolute;
    inset-block-start: 0;
  }

  .caption-number {
    color: var(--link);
  }

  .caption-stage {
    color: var(--text);
  }

  /* The last frame in text: 15px Geist Mono and 16px lines keep the renderer's 9 × 16 cell. */
  .scene-still {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    font-size: 0.9375rem;
    line-height: 1rem;
    letter-spacing: 0;
    white-space: pre;

    & > span {
      display: block;
    }
  }

  /* The text frame steps aside while a run plays and once the renderer has drawn. */
  .instrument:not([data-run-state="final"]) .scene-still,
  .scene[data-drawn] .scene-still {
    visibility: hidden;
  }

  /* The renderer's inks: boxes and names in text ink, the run's path in the accent, checks in
     pass green. Mixed into the ground, not made transparent: box lines overlap between rows,
     and a translucent overlap would show. Geist Mono has no check mark, so the check keeps one
     cell in the fallback face. */
  .frame-box {
    color: color-mix(in srgb, var(--text) 62%, var(--ground));
  }

  .frame-name {
    color: color-mix(in srgb, var(--text) 82%, var(--ground));
  }

  .frame-link {
    color: color-mix(in srgb, var(--link) 82%, var(--ground));
  }

  .frame-check {
    display: inline-block;
    inline-size: 1ch;
    overflow: hidden;
    color: var(--pass);
    text-align: center;
    vertical-align: top;
  }

  .body {
    padding: var(--space-5) var(--space-5) var(--space-3);
    background: var(--panel);
  }

  .spec {
    min-block-size: 5.5rem;
    margin: 0 0 var(--space-4);
    overflow: hidden;
    color: var(--code-punctuation);
    font: inherit;
    white-space: pre;

    .kw {
      color: var(--code-keyword);
    }

    .fn,
    .id {
      color: var(--code-function);
    }

    .str {
      color: var(--code-string);
    }

    /* The caret is added by the run script, so it is styled from outside this component. */
    :global(.caret) {
      display: inline-block;
      inline-size: 0.6em;
      block-size: 1.05em;
      margin-inline-start: 1px;
      vertical-align: -0.18em;
      background: var(--link);

      @media (prefers-reduced-motion: no-preference) {
        animation: blink 1s steps(1) infinite;
      }
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .stages {
    margin: 0 0 var(--space-3);
    padding: var(--space-1) 0 0;
    background: var(--dotted-rule);
    background-position: 0 0;
    list-style: none;
  }

  .stage {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    block-size: var(--space-7);
  }

  .stage-name {
    color: var(--text);

    @media (prefers-reduced-motion: no-preference) {
      transition: color 0.35s var(--ease-out);
    }
  }

  .leader {
    flex: 1;
    block-size: 3px;
    background: var(--dotted-rule);
  }

  .stage-run {
    display: none;
    color: var(--muted);
  }

  /* Each stage's marker is an empty box while pending; the check draws in when it passes. */
  .check {
    inline-size: 18px;
    block-size: 18px;
    color: var(--pass);

    path {
      stroke-dasharray: 16;
      stroke-dashoffset: 0;

      @media (prefers-reduced-motion: no-preference) {
        transition: stroke-dashoffset 0.5s var(--ease-out) 0.08s;
      }
    }
  }

  .check-box {
    fill: none;
    stroke: var(--muted);
    stroke-width: 1;
    opacity: 0;
  }

  .stage[data-state="pending"] {
    .stage-name {
      color: var(--muted);
    }

    .check path {
      stroke-dashoffset: 16;
    }

    .check-box {
      opacity: 1;
    }
  }

  /* Running: the one stage the scene is showing, in ink, with a copper caret in the gutter
     before its name and a muted "running…" in place of its check. */
  .stage[data-state="running"] {
    &::before {
      content: "";
      position: absolute;
      inset-block-start: 7px;
      inset-inline-start: -14px;
      inline-size: 7px;
      block-size: 14px;
      background: var(--link);

      @media (prefers-reduced-motion: no-preference) {
        animation: blink 1s steps(1) infinite;
      }
    }

    .stage-run {
      display: inline;
    }

    .check {
      display: none;
    }
  }

  .data {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    margin: 0;

    @media (prefers-reduced-motion: no-preference) {
      transition: opacity 0.5s var(--ease-out);
    }

    /* The first run shows the facts once its scene has played. */
    &[data-pending] {
      opacity: 0;
    }

    & > div {
      display: contents;
    }

    dt,
    dd {
      padding: 3px 0;
      background: var(--dotted-rule);
      background-position: 0 0;
    }

    dt {
      color: var(--muted);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
    }

    dd {
      margin: 0;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
  }

  /* Until the run script primes the first run, the parts it types and ticks stay hidden, so
     the final frame never flashes before the typing. If the script never arrives, they show
     after 3 s. The pre-paint script in BaseLayout sets the class when motion is allowed. */
  :global(.run-pending) .spec code,
  :global(.run-pending) .stage,
  :global(.run-pending) .data,
  :global(.run-pending) .scene-caption,
  :global(.run-pending) .scene-still {
    visibility: hidden;
    animation: reveal 0s 3s forwards;
  }

  @keyframes reveal {
    to {
      visibility: visible;
    }
  }

  @media (width < 60em) {
    .bar {
      flex-wrap: wrap;
      row-gap: 0;
      block-size: auto;
      min-block-size: var(--space-10);
      padding-block: var(--space-1);
      letter-spacing: 0.04em;
    }

    .control {
      min-inline-size: var(--target-min);
      block-size: var(--target-min);
    }

    .scene {
      block-size: 14rem;
    }

    .scene-caption {
      block-size: var(--space-8);
      white-space: normal;
    }

    .body {
      padding: var(--space-4) var(--space-4) var(--space-2);
    }

    .spec {
      font-size: 0.75rem;
    }
  }

  /* Phones: the suite name takes the first row; status and the run controls share the second.
     From tablets up the three fit on one row, even while a run shows Skip beside Rerun. */
  @media (width < 36em) {
    .title {
      flex-basis: 100%;
      line-height: var(--space-7);
    }
  }
</style>
