---
import { useTranslations, type Locale } from "../i18n/ui";
import { cvDownloadFor, isInPublicDir } from "../lib/cv";
import { breakOnlyBetween } from "../lib/typography";
import { contact, owner } from "../site";
import Instrument from "./Instrument.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const nameParts = owner.name.split(" ");
const cv = cvDownloadFor(locale, isInPublicDir(process.cwd()));
---

<section class="hero" id="top" aria-labelledby="hero-heading">
  <div class="copy">
    <h1 class="headline" id="hero-heading">
      {nameParts.map((part, index) => (
        <Fragment>
          {index > 0 && " "}
          <span>{part}</span>
        </Fragment>
      ))}
    </h1>
    <p class="display-line">{t("home.displayLine")}</p>
    <p class="sub">{t("hero.sub")}</p>
    <p class="disciplines">{breakOnlyBetween(t("hero.disciplines"))}</p>
    <div class="actions">
      <a class="button button-primary" href={`mailto:${contact.email}`}>
        <span class="bracket" aria-hidden="true">
          [
        </span>
        {t("hero.primaryAction")}
        <span class="bracket" aria-hidden="true">
          ]
        </span>
      </a>
      {cv && (
        <a
          class="button button-secondary"
          href={cv.href}
          type="application/pdf"
        >
          <span class="bracket" aria-hidden="true">
            [
          </span>
          {t("hero.cvAction")}
          <span class="bracket" aria-hidden="true">
            ]
          </span>
        </a>
      )}
    </div>
    {/* The suite's own note: this site is tested, and the report says how. The separator is
        read, not shown: the arrow stands for it on screen. */}
    <a class="report-link" href="#report">
      <span>{t("hero.reportNote")}</span>
      <span class="visually-hidden"> · </span>
      <span class="report-action">
        <svg
          viewBox="0 0 16 16"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M2.5 8h10M9 4.5 12.5 8 9 11.5"></path>
        </svg>
        {t("hero.reportAction")}
      </span>
    </a>
  </div>
  <Instrument locale={locale} />
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 35rem);
    gap: var(--space-18);
    align-items: center;
    max-inline-size: var(--page-max-width);
    min-block-size: calc(
      100svh - var(--header-height) - var(--reading-progress-height)
    );
    margin-inline: auto;
    padding: var(--space-10) var(--gutter) var(--space-16);
  }

  /* The name is the headline; the promise is the display line under it. */
  .headline {
    margin-block-end: var(--space-7);
    font-family: var(--font-display);
    font-size: var(--type-headline-size);
    font-weight: 600;
    line-height: var(--type-headline-leading);
    letter-spacing: var(--type-headline-tracking);

    span {
      display: block;
    }
  }

  .display-line {
    margin-block-end: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--type-display-line-size);
    font-weight: 500;
    line-height: var(--type-display-line-leading);
    letter-spacing: var(--type-display-line-tracking);
    text-wrap: balance;
  }

  .sub {
    margin-block-end: var(--space-5);
    color: var(--muted);
    font-size: var(--type-lead-size);
    line-height: var(--type-lead-leading);
  }

  /* The disciplines close the copy: what he does, in the grid's mono voice, set close under
     the promise and well clear of the actions. */
  .disciplines {
    margin-block-end: var(--space-10);
    color: var(--accent-text);
    font-family: var(--font-mono);
    font-size: var(--type-ui-size);
    line-height: var(--type-ui-leading);
    letter-spacing: 0.03em;
    text-wrap: balance;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    block-size: var(--space-12);
    padding-inline: 1.375rem;
    border: 1px solid var(--fill);
    font-family: var(--font-mono);
    font-size: var(--type-ui-size);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.1em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      background-color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out),
      color var(--duration-quick) var(--ease-out);

    &:active {
      translate: 0 1px;
    }
  }

  .bracket {
    opacity: 0.55;
  }

  .button-primary {
    background: var(--fill);
    color: var(--on-fill);

    &:hover {
      border-color: var(--fill-hover);
      background: var(--fill-hover);
    }
  }

  .button-secondary {
    border-color: var(--dots);
    background: var(--ground);
    color: var(--text);

    &:hover {
      border-color: var(--link);
      background: var(--panel);
    }
  }

  /* A quiet bordered note under the actions, in the grid's mono voice; only its action is
     underlined, as a link. */
  .report-link {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2px var(--space-3);
    margin-block-start: var(--space-8);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule);
    background: var(--ground);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: var(--type-ui-size);
    line-height: var(--type-ui-leading);
    letter-spacing: var(--type-ui-tracking);
    text-decoration: none;
    transition: border-color var(--duration-quick) var(--ease-out);

    svg {
      inline-size: 0.875rem;
      block-size: 0.875rem;
    }

    &:hover {
      border-color: var(--dots);

      .report-action {
        text-decoration-thickness: 2px;
      }
    }
  }

  .report-action {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  @media (width < 60em) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-12);
      min-block-size: 0;
    }

    .headline {
      margin-block-end: var(--space-5);
    }

    .display-line {
      margin-block-end: var(--space-2);
    }

    .sub {
      margin-block-end: var(--space-4);
      font-size: 1.1875rem;
      line-height: calc(28 / 19);
    }

    .disciplines {
      margin-block-end: var(--space-8);
    }

    .actions {
      gap: var(--space-3);
    }

    .button {
      padding-inline: var(--space-4);
    }
  }

  /* Phones: the actions run full width. */
  @media (width < 30em) {
    .actions {
      flex-direction: column;
    }
  }
</style>
