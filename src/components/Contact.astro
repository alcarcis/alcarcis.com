---
import { useTranslations, type Locale } from "../i18n/ui";
import { cvDownloadFor, isInPublicDir } from "../lib/cv";
import { contact } from "../site";
import Certificate from "./Certificate.astro";
import SectionHead from "./SectionHead.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

/* The CV beside copy, only when it ships: by Contact the hero's CV button is far above. */
const cv = cvDownloadFor(locale, isInPublicDir(process.cwd()));
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <SectionHead
    locale={locale}
    testCase={5}
    headingId="contact-heading"
    title={t("contact.title")}
  />
  {/* The script reads each outcome's label and announcement here, in this page's language. */}
  <div
    class="address"
    data-copy-address
    data-copied-label={t("contact.copied")}
    data-copied-message={t("contact.announce.copied")}
    data-selected-label={t("contact.selected")}
    data-selected-message={t("contact.announce.selected")}
  >
    <a
      class="email"
      id="contact-address"
      href={`mailto:${contact.email}`}
      data-copy-source
    >
      {contact.email}
    </a>
    {/* The actions stay together: when the line runs out, they move below the address. */}
    <span class="actions" data-contact-actions>
      <button
        class="action copy"
        type="button"
        aria-describedby="contact-address"
      >
        <span class="bracket" aria-hidden="true">
          [
        </span>
        <svg
          class="icon"
          data-icon="copy"
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <rect x="7" y="7" width="10" height="10" rx="1.5"></rect>
          <path d="M13 7V4.5A1.5 1.5 0 0 0 11.5 3h-7A1.5 1.5 0 0 0 3 4.5v7A1.5 1.5 0 0 0 4.5 13H7"></path>
        </svg>
        <svg
          class="icon"
          data-icon="check"
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M4 10.5 8 14.5 16 5.5"></path>
        </svg>
        {/* At rest the icon shows and these words only name the button; an outcome shows them. */}
        <span class="label" data-copy-label>
          {t("contact.copy")}
        </span>
        <span class="copy-target">{` ${t("contact.copyTarget")}`}</span>
        <span class="bracket" aria-hidden="true">
          ]
        </span>
      </button>
      {/* Outside the button: a live region inside a button is not reliably announced. */}
      <span class="visually-hidden" role="status"></span>
      {cv && (
        <Fragment>
          {/* A drawn middle dot, not a glyph: one character of text is too short for the
              contrast check to judge, and the dot is for the eye only. */}
          <span class="separator" aria-hidden="true" data-copy-separator></span>
          <a class="action cv" href={cv.href} type="application/pdf">
            <span class="bracket" aria-hidden="true">
              [
            </span>
            <svg
              class="icon"
              data-icon="download"
              width="18"
              height="18"
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M10 3v10M5.5 8.5 10 13l4.5-4.5M4 17h12" />
            </svg>
            {/* The verb completes the name, which still holds the visible words (WCAG 2.5.3). */}
            <span class="visually-hidden">{`${t("contact.cv.action")} `}</span>
            <span class="cv-label">{t("contact.cv")}</span>
            <span class="bracket" aria-hidden="true">
              ]
            </span>
          </a>
        </Fragment>
      )}
    </span>
  </div>
  <Certificate locale={locale} />
</section>

<script>
  import "../scripts/contact/copy-address";
</script>

<style>
  /* One centred column at every width: the address line, then the certificate below it, with
     room between for the seal that reaches above the certificate's corner. */
  .contact {
    max-inline-size: var(--page-max-width);
    margin-inline: auto;
    padding: 0 var(--gutter) var(--section-space-end);
  }

  /* The address is the link itself, at display size, with its two actions after it. When the
     line runs out, the address keeps a line of its own and the actions centre below it. */
  .address {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    margin-block-end: var(--space-14);
  }

  .email {
    display: inline-block;
    /* On phones the line is shorter than a target: the padding makes up the difference. */
    padding-block: max(0px, (var(--target-min) - 1lh) / 2);
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--type-display-line-size);
    font-weight: 500;
    line-height: var(--type-display-line-leading);
    letter-spacing: var(--type-display-line-tracking);
    text-decoration-color: var(--link);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.16em;

    &:hover {
      text-decoration-thickness: 3px;
    }
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0 var(--space-2);
  }

  /* Both actions in the site's bracket style: an icon in the header's style, in the link
     colour, on a full target. */
  .action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-inline-size: var(--target-min);
    min-block-size: var(--target-min);
    padding-inline: var(--space-2);
    border: 1px solid transparent;
    color: var(--link);
    font-family: var(--font-mono);
    font-size: var(--type-ui-size);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .icon {
    flex: none;
  }

  .bracket {
    opacity: 0.55;
  }

  .separator {
    inline-size: 3px;
    block-size: 3px;
    border-radius: 50%;
    background: var(--dots);
  }

  .copy {
    background: var(--ground);
    cursor: pointer;
    transition:
      border-color var(--duration-quick) var(--ease-out),
      color var(--duration-quick) var(--ease-out);

    &:hover {
      border-color: var(--dots);
    }

    [data-icon="check"] {
      display: none;
    }

    /* At rest the icon speaks for the button: its words stay for assistive technology only. */
    &:not([data-state]) :is(.label, .copy-target),
    &[data-state] .copy-target {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      margin: -1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    &[data-state] .copy-target {
      display: none;
    }

    /* The outcome shows in words and in colour: a check and the word in pass green when
       copied, plain words when the visitor has to copy the selected address. */
    &[data-state] [data-icon="copy"] {
      display: none;
    }

    &[data-state="copied"] {
      border-color: currentColor;
      color: var(--pass);

      [data-icon="check"] {
        display: block;
      }
    }

    &[data-state="selected"] {
      border-color: var(--dots);
      color: var(--text);
    }
  }

  /* The link's own underline would run under its brackets and icon: only the words carry one. */
  .cv {
    text-decoration: none;
  }

  .cv-label {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .cv:hover .cv-label {
    text-decoration-thickness: 2px;
  }

  /* Without scripting the button could not copy, so it is not offered, nor the dot after it;
     the address stays a link, and its text can still be selected and copied by hand. */
  @media (scripting: none) {
    .copy,
    .separator {
      display: none;
    }
  }
</style>
