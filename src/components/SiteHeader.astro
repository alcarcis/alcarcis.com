---
import GitHub from "../assets/icons/github.svg";
import LinkedIn from "../assets/icons/linkedin.svg";
import { useTranslations, type Locale } from "../i18n/ui";
import { owner, profiles } from "../site";
import LanguageSwitch from "./LanguageSwitch.astro";
import LogoMark from "./LogoMark.astro";
import SectionsNav from "./SectionsNav.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  path?: string;
}

const { locale, path = "" } = Astro.props;
const t = useTranslations(locale);

const menuId = "sections-menu";

const profileLinks = [
  { href: profiles.linkedIn, label: t("header.linkedIn"), Icon: LinkedIn },
  { href: profiles.gitHub, label: t("header.gitHub"), Icon: GitHub },
];
---

<header class="site-header">
  <span class="rule" aria-hidden="true"></span>
  <div class="bar">
    {/*
      An aria-label, not visually hidden text: Chrome joins a positioned hidden span to the name
      with a space ("Carlos Alcalá , back to top"). The name still starts with the visible label.
    */}
    <a
      class="owner"
      href="#top"
      aria-label={`${owner.name}, ${t("header.backToTop")}`}
    >
      <span class="mark-frame">
        <LogoMark class="mark" blink />
      </span>
      <span class="owner-name">{owner.name}</span>
    </a>
    <SectionsNav locale={locale} menuId={menuId} />
    <div class="tools">
      {profileLinks.map(({ href, label, Icon }) => (
        <a class="icon-button profile-icon" href={href}>
          <Icon width={18} height={18} aria-hidden="true" />
          <span class="visually-hidden">{label}</span>
        </a>
      ))}
      <LanguageSwitch locale={locale} path={path} />
      <ThemeToggle locale={locale} />
      {/* Opens the sections menu below 1200 px; a native popover, so it works without script. */}
      <button
        class="icon-button menu-button"
        type="button"
        popovertarget={menuId}
        aria-controls={menuId}
        data-sections-menu-button
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 20 20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M3 6h14M3 10h14M3 14h14"></path>
        </svg>
        <span class="visually-hidden">{t("sectionsNav.menu")}</span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    background: var(--ground);
  }

  /* The dotted rule under the bar is an element of its own, not a pseudo-element: a contrast
     check cannot decide on text inside a box with a painted pseudo-element. */
  .rule {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: 3px;
    background: var(--dotted-rule);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    max-inline-size: var(--page-max-width);
    block-size: var(--header-height);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  /* The mark and the name are one link back to the top. */
  .owner {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    color: var(--text);
    text-decoration: none;
    text-underline-offset: 4px;

    &:hover {
      text-decoration-line: underline;
      text-decoration-thickness: 1px;
    }

    &:hover .mark-frame {
      border-color: var(--dots);
    }
  }

  /* The mark stands free, as Carlos drew it (D61). Its 40 px square keeps the link a full target
     with the name hidden, and shows a border on hover, as the bar's icon buttons do. A fixed
     size, not --target-min: on phones the bar has no room for a wider square at 320 px. */
  .mark-frame {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border: 1px solid transparent;
    transition: border-color var(--duration-quick) var(--ease-out);
  }

  .mark-frame :global(.mark) {
    inline-size: 2rem;
    block-size: auto;
  }

  .owner-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.125rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-inline-start: auto;
  }

  /* The bar holds the section links from 1200 px; below it they wait behind the menu button. */
  @media (width >= 75em) {
    .menu-button {
      display: none;
    }
  }

  @media (width < 60em) {
    .bar {
      gap: var(--space-3);
    }

    .owner {
      gap: 0.625rem;
      min-block-size: var(--target-min);
    }

    .tools {
      gap: 0;
    }
  }

  /* Phones: the name takes two lines beside the mark, and the profile links move into the
     sections menu (they are in Contact too). */
  @media (width < 30em) {
    .profile-icon {
      display: none;
    }

    .owner-name {
      inline-size: min-content;
      font-size: var(--type-ui-size);
      line-height: 1rem;
      white-space: normal;
    }
  }
</style>
