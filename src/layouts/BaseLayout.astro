---
import "../styles/tokens.css";
import "../styles/base.css";
import { Font } from "astro:assets";
import Footer from "../components/Footer.astro";
import GlyphField from "../components/GlyphField.astro";
import ReadingProgress from "../components/ReadingProgress.astro";
import SiteHeader from "../components/SiteHeader.astro";
import {
  languageAlternates,
  openGraphLocales,
  shareImageSize,
  shareImages,
  touchIcon,
} from "../lib/seo";
import { themeStorageKey } from "../lib/theme";
import {
  defaultLocale,
  locales,
  localizedUrl,
  useTranslations,
  type Locale,
} from "../i18n/ui";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
}

const { locale, title, description, path = "" } = Astro.props;
const t = useTranslations(locale);

const canonicalUrl = localizedUrl(locale, path);
const alternateLinks = languageAlternates(locales, defaultLocale, (hreflang) =>
  localizedUrl(hreflang, path),
);

// Link previews and crawlers need absolute URLs.
const homeUrl = localizedUrl(defaultLocale);
const absoluteUrl = (href: string): string => new URL(href, homeUrl).href;

const shareImage = shareImages[locale];
const otherLocales = locales.filter((other) => other !== locale);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline define:vars={{ themeStorageKey }}>
      try {
        const theme = localStorage.getItem(themeStorageKey);
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
          document
            .querySelector('meta[name="color-scheme"]')
            ?.setAttribute("content", theme);
        }
      } catch {
        // Storage can be blocked; the system preference decides the theme then.
      }
      // The instrument types its spec when motion is welcome; until its script primes the run,
      // the parts it types stay hidden so the final frame never flashes first.
      if (matchMedia("(prefers-reduced-motion: no-preference)").matches) {
        document.documentElement.classList.add("run-pending");
      }
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href={touchIcon.path} />
    <link rel="canonical" href={canonicalUrl} />
    {alternateLinks.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {otherLocales.map((other) => (
      <meta property="og:locale:alternate" content={openGraphLocales[other]} />
    ))}
    <meta property="og:image" content={absoluteUrl(shareImage.path)} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(shareImageSize.width)} />
    <meta property="og:image:height" content={String(shareImageSize.height)} />
    <meta property="og:image:alt" content={shareImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t("a11y.skipToContent")}
    </a>
    <GlyphField />
    <SiteHeader locale={locale} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
    <ReadingProgress />
  </body>
</html>

<style>
  /* Content sits above the grain field. */
  main {
    position: relative;
    z-index: 1;
  }
</style>
